NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Microsoft Entra (Azure AD) sign-in. CLIENT_ID = the app registration's
# Application (client) ID. AUTHORITY: /common (work + personal), /organizations
# (work/school only), or /<tenant-guid>. REDIRECT_URI must match the SPA redirect
# registered in Azure (locally, http://localhost:3000/auth/microsoft/callback).
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-azure-application-client-id
NEXT_PUBLIC_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
NEXT_PUBLIC_SEARCH_LANGGRAPH_ENABLED=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_AGENTIC_SEARCH_CORESIGNAL=true