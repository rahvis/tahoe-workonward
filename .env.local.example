NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Microsoft Entra (Azure AD) sign-in — see .env.example for notes.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-azure-application-client-id
NEXT_PUBLIC_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JLBXPV59L0
NEXT_PUBLIC_SEARCH_LANGGRAPH_ENABLED=true
# Coresignal agentic search mode. When "true", the search page renders the agentic
# UI instead of LangGraph. NEXT_PUBLIC_* is inlined at build time, so a rebuild is
# required to flip it. Backend must also set AGENTIC_SEARCH_CORESIGNAL=true.
NEXT_PUBLIC_AGENTIC_SEARCH_CORESIGNAL=true
